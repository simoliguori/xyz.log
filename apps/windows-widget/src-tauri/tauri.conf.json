{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xyz.log",
  "version": "0.2.0",
  "identifier": "dev.simol.xyzlog",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "xyz.log",
        "label": "main",
        "dragDropEnabled": false,
        "width": 900,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "center": true,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": false,
        "alwaysOnBottom": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxRkI0RDA3NDYxRjgzMjQKUldRa2d4OUdCMDM3Z2VEL2wwQ2hjMmwyTGNleXNpZm9JbUIwM3ZVaytpT3pFN3hoV2MySGpMK2cK",
      "endpoints": [
        "https://github.com/simoliguori/xyz.log/releases/latest/download/latest.json"
      ]
    }
  }
}
