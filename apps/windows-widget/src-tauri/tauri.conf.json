{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xyz.log",
  "version": "0.1.0",
  "identifier": "dev.simol.xyzlog",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5177",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "xyz.log",
        "label": "main",
        "width": 900,
        "height": 560,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
